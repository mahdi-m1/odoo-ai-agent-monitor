# ===== Odoo Connection (Odoo 19 / 20 → JSON-2) =====
ODOO_URL=http://your-odoo-host:8069
ODOO_DB=your_database
# Preferred: API Key from Preferences → Account Security → New API Key
ODOO_API_KEY=your_api_key_here
# Protocol: json2 (default, Odoo 19/20+) | xmlrpc (legacy ≤18 only)
ODOO_PROTOCOL=json2
# Only for xmlrpc fallback:
ODOO_USER=admin
ODOO_PASSWORD=

# ===== Agent =====
AGENT_LANGUAGE=ar
WEEKLY_REPORT_DAY=sunday
WEEKLY_REPORT_HOUR=8
TIMEZONE=Asia/Bahrain

# ===== Claude CLI =====
# Absolute path recommended under systemd (e.g. /root/.local/bin/claude)
CLAUDE_CLI_PATH=claude
# Alias (opus | sonnet | haiku | fable) or full id. Empty = Claude CLI default. Can be changed from the web UI.
CLAUDE_MODEL=

# ===== Social channels (optional — can also be set from the web UI → المصادر والقنوات) =====
SOCIAL_ENABLED=false
SOCIAL_PUBLIC_FETCH=false
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=

# ===== Web Interface =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
SECRET_KEY=change-me-to-a-random-string

# ===== Memory (persistent, archived) =====
# auto = use local multilingual embeddings if available (downloads ~240MB to data/models once) | on | off
MEMORY_EMBEDDINGS=auto

# ===== Backup =====
# Google Drive is linked from the web UI (رفع ملف بيانات الربط) — no keys in .env.
# Schedule, encryption passphrase and retention are set in the UI (data/backup_settings.json).

# ===== JS page rendering (optional) =====
# For interactive official portals that need JavaScript. auto = use if Chromium installed | on | off
# Install once: python -m playwright install chromium
BROWSER_RENDER=auto

# ===== Odoo Connection (Odoo 19 / 20 → JSON-2) =====
ODOO_URL=http://your-odoo-host:8069
ODOO_DB=your_database
# Preferred: API Key from Preferences → Account Security → New API Key
ODOO_API_KEY=your_api_key_here
# Protocol: json2 (default, Odoo 19/20+) | xmlrpc (legacy ≤18 only)
ODOO_PROTOCOL=json2
# Only for xmlrpc fallback:
ODOO_USER=admin
ODOO_PASSWORD=

# ===== Agent =====
AGENT_LANGUAGE=ar
WEEKLY_REPORT_DAY=sunday
WEEKLY_REPORT_HOUR=8
TIMEZONE=Asia/Bahrain

# ===== Claude CLI =====
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=claude-sonnet-4-20250514

# ===== Web Interface =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
SECRET_KEY=change-me-to-a-random-string

[Unit]
Description=Odoo AI Agent Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/odoo-ai-agent-monitor
Environment=PATH=/opt/odoo-ai-agent-monitor/venv/bin
EnvironmentFile=-/opt/odoo-ai-agent-monitor/.env
ExecStart=/opt/odoo-ai-agent-monitor/venv/bin/uvicorn web.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
